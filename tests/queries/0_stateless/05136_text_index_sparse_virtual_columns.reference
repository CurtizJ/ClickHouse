-- sparse virtual columns per query
materialize	hasToken(s, \'rare\')	1
materialize	hasToken(s, \'common\')	0
materialize	hasAllTokens(s, [\'common\', \'rare\'])	1
materialize	hasAnyTokens(s, [\'common\', \'rare\'])	0
materialize	hasAnyTokens(s, [\'rare\', \'scarce\'])	1
materialize	hasPhrase(s, \'rare scarce\')	1
materialize	hasToken(s, \'rare\') OR hasToken(s, \'scarce\')	1
materialize	hasToken(s, \'scarce\') AND id % 2 = 1	1
materialize	s LIKE \'%scarce%\'	1
materialize	hasToken(s, \'rare\') SETTINGS text_index_ratio_of_defaults_for_sparse_columns = 1.0	0
